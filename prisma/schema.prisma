// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum USER_ROLE {
  ADMIN
  USER
}

enum EVTOL_MODEL {
  LIGHTWEIGHT
  MIDDLEWEIGHT
  CRUISERWEIGHT
  HEAVYWEIGHT
}

enum EVTOL_STATE {
  IDLE
  LOADING
  LOADED
  DELIVERING
  DELIVERED
  RETURNING
  EMERGENCY_LANDING
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String?
  firstName      String?
  lastName       String?
  role           USER_ROLE @default(USER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  LoadedMedication LoadedMedication[]
}

model Evtol {
  id               Int          @id @default(autoincrement())
  serialNumber     String       @unique
  model           EVTOL_MODEL
  state           EVTOL_STATE
  weightLimit     Int
  batteryCapacity Float  @default(100.0) 
  latitude        Float  @default(0.0)
  longitude       Float  @default(0.0)
  medications     Medication[] @relation("EvtolMedications")
  isCharging      Boolean @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  BatteryLog BatteryLog[]

  LoadedMedication LoadedMedication[]

  Delivery Delivery[]
}

model Medication {
  id           Int              @id @default(autoincrement())
  name         String
  weight       Int
  code         Int
  imageUrl     String
  evtols       Evtol[] @relation("EvtolMedications") 
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  LoadedMedication LoadedMedication[]
}

model LoadedMedication {
  id              Int         @id @default(autoincrement())
  evtolId        Int
  medicationId   Int
  loadedByUserId Int
  loadedAt       DateTime @default(now())

  evtol          Evtol    @relation(fields: [evtolId], references: [id], onDelete: Cascade)
  medication     Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  loadedBy       User    @relation(fields: [loadedByUserId], references: [id], onDelete: Cascade)
}


model BatteryLog {
  id         Int      @id @default(autoincrement())
  evtolId    Int
  evtol      Evtol    @relation(fields: [evtolId], references: [id], onDelete: Cascade)
  level      Int      // Battery level at the time of log
  createdAt  DateTime @default(now())
}

model ChargingStation {
  id        String   @id @default(uuid())
  name      String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Delivery {
  id          String   @id @default(uuid())
  evtolId     String   @unique
  evtol       Evtol    @relation(fields: [evtolId], references: [serialNumber])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


